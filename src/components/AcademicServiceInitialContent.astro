---
import EntryList from "./EntryList.astro";
import { academicServiceContent } from "../data/generated/academicServiceContent";
import { siteTranslations } from "../data/generated/siteI18n";
import { defaultLang, type Lang } from "../utils/content";

const { lang = defaultLang } = Astro.props as { lang?: Lang };
const page = siteTranslations.page.academicService[lang];
---

<section>
  <h2 class="section-title">{page.selectedTitle}</h2>
  <p class="section-note">{page.selectedNote}</p>
  <EntryList entries={academicServiceContent.selected} lang={lang} />
</section>
<section>
  <h2 class="section-title">{page.serviceTitle}</h2>
  <p class="section-note">{page.serviceNote}</p>
  <EntryList entries={academicServiceContent.service} lang={lang} />
</section>
