---
import ProjectImageGrid from "./ProjectGallery/ProjectImageGrid.astro";
import { siteProjectsContent } from "../data/generated/projectsContent";
import { siteTranslations } from "../data/generated/siteI18n";
import {
  defaultLang,
  formatProjectLanguageSummary,
  getLangValue,
  getProjectKey,
  resolveProjectItem,
  type Lang,
} from "../utils/content";

const { lang = defaultLang } = Astro.props as { lang?: Lang };
const page = siteTranslations.page.projects[lang];
const catalog = siteProjectsContent.catalog || {};
const rankedItems = siteProjectsContent.ranked || [];
const rankedKeys = new Set(rankedItems.map(getProjectKey).filter(Boolean));
const remainingItems = (siteProjectsContent.all || []).filter(
  (item) => !rankedKeys.has(getProjectKey(item)),
);

function normalizeItems(items: any[]) {
  return items.map((rawItem) => {
    const item = resolveProjectItem(rawItem, catalog);
    return {
      ...item,
      languageLabel: formatProjectLanguageSummary(item, lang),
      note: getLangValue(item, lang, "note"),
      updatedLabel: item.updated ? `${lang === "zh" ? "更新于" : "updated"} ${item.updated}` : "",
    };
  });
}

function getProjectLinkClass(link: any) {
  const label = String(link.label || link.labelEn || link.labelZh || "").toLowerCase();
  return [
    "project-meta-pill",
    "project-meta-pill-link",
    label === "demo" ? "project-meta-pill-link-demo" : "",
  ]
    .filter(Boolean)
    .join(" ");
}

const rankedProjects = normalizeItems(rankedItems);
const remainingProjects = normalizeItems(remainingItems);
---

<section>
  <h2 class="section-title">{page.rankingTitle}</h2>
  <p class="section-note">{page.rankingNote}</p>
  <ol class="repo-list">
    {
      rankedProjects.map((item) => (
        <li>
          <div class="repo-line">
            <a href={item.url} target="_blank" rel="noreferrer">
              {item.name}
            </a>{" "}
            <div class="project-meta-pills">
              <span class="project-meta-pill">{item.languageLabel}</span>
              {item.updatedLabel && <span class="project-meta-pill">{item.updatedLabel}</span>}
              {(item.links || []).map((link: any) => (
                <a
                  class={getProjectLinkClass(link)}
                  href={link.url}
                  target="_blank"
                  rel="noreferrer"
                >
                  {getLangValue(link, lang, "label") || link.label || link.url}
                </a>
              ))}
            </div>
          </div>
          {item.note && <div class="item-note">{item.note}</div>}
          <ProjectImageGrid images={item.images || []} lang={lang} extraClass="repo-image-grid" />
        </li>
      ))
    }
  </ol>
</section>
<section>
  <h2 class="section-title">{page.allTitle}</h2>
  <p class="section-note">{page.allNote}</p>
  <ol class="repo-list">
    {
      remainingProjects.map((item) => (
        <li>
          <div class="repo-line">
            <a href={item.url} target="_blank" rel="noreferrer">
              {item.name}
            </a>{" "}
            <div class="project-meta-pills">
              <span class="project-meta-pill">{item.languageLabel}</span>
              {item.updatedLabel && <span class="project-meta-pill">{item.updatedLabel}</span>}
              {(item.links || []).map((link: any) => (
                <a
                  class={getProjectLinkClass(link)}
                  href={link.url}
                  target="_blank"
                  rel="noreferrer"
                >
                  {getLangValue(link, lang, "label") || link.label || link.url}
                </a>
              ))}
            </div>
          </div>
          {item.note && <div class="item-note">{item.note}</div>}
          <ProjectImageGrid images={item.images || []} lang={lang} extraClass="repo-image-grid" />
        </li>
      ))
    }
  </ol>
</section>
