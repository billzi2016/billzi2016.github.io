<div class="header-actions">
  <button id="lang-toggle" class="language-switch" type="button" aria-label="Switch language">
    <span class="language-switch-option language-switch-option-en">EN</span>
    <span class="language-switch-option language-switch-option-zh">中文</span>
    <span class="language-switch-thumb"></span>
  </button>
  <button id="theme-toggle" class="theme-switch" type="button" aria-label="Switch theme">
    <span class="theme-switch-track">
      <span class="theme-switch-glow theme-switch-glow-one"></span>
      <span class="theme-switch-glow theme-switch-glow-two"></span>
      <span class="theme-switch-glow theme-switch-glow-three"></span>
      <span class="theme-switch-scene theme-switch-scene-day">
        <span class="theme-switch-cloudbank theme-switch-cloudbank-back"></span>
        <span class="theme-switch-cloudbank theme-switch-cloudbank-front"></span>
      </span>
      <span class="theme-switch-scene theme-switch-scene-night">
        <span class="theme-switch-stars">
          <span class="theme-switch-star theme-switch-star-one"></span>
          <span class="theme-switch-star theme-switch-star-two"></span>
          <span class="theme-switch-star theme-switch-star-three"></span>
          <span class="theme-switch-star theme-switch-star-four"></span>
          <span class="theme-switch-star theme-switch-star-five"></span>
          <span class="theme-switch-star theme-switch-star-six"></span>
          <span class="theme-switch-star theme-switch-star-seven"></span>
          <span class="theme-switch-star theme-switch-star-eight"></span>
          <span class="theme-switch-star theme-switch-star-nine"></span>
        </span>
      </span>
      <span class="theme-switch-thumb">
        <span class="theme-switch-thumb-sun"></span>
        <span class="theme-switch-thumb-moon">
          <span class="theme-switch-crater theme-switch-crater-one"></span>
          <span class="theme-switch-crater theme-switch-crater-two"></span>
          <span class="theme-switch-crater theme-switch-crater-three"></span>
        </span>
      </span>
    </span>
  </button>
</div>
