---
import { siteTranslations } from "../data/generated/siteI18n";

const defaultCopy = siteTranslations.common.en;
---

<footer class="site-footer">
  <div class="site-footer__content">
    <a
      class="site-footer__link"
      href="./docs/"
      target="_blank"
      rel="noreferrer"
      data-i18n="footerAbout"
    >
      {defaultCopy.footerAbout}
    </a>
    <span class="site-footer__separator" aria-hidden="true">/</span>
    <a
      class="site-footer__link"
      href="./docs/maintenance-plan/"
      target="_blank"
      rel="noreferrer"
      data-i18n="footerDocs"
    >
      {defaultCopy.footerDocs}
    </a>
    <span class="site-footer__separator" aria-hidden="true">/</span>
    <a
      class="site-footer__link"
      href="https://github.com/billzi2016/billzi2016.github.io"
      target="_blank"
      rel="noreferrer"
      data-i18n="footerSource"
    >
      {defaultCopy.footerSource}
    </a>
  </div>
  <p class="site-footer__tech" data-i18n="footerTech">
    {defaultCopy.footerTech}
  </p>
  <p class="site-footer__ai" data-i18n="footerAi">
    {defaultCopy.footerAi}
  </p>
  <p class="site-footer__availability" data-i18n="footerAvailability">
    {defaultCopy.footerAvailability}
  </p>
</footer>
