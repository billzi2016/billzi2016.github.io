<button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch theme">
  <span class="theme-toggle-track">
    <span class="theme-toggle-glow theme-toggle-glow-one"></span>
    <span class="theme-toggle-glow theme-toggle-glow-two"></span>
    <span class="theme-toggle-glow theme-toggle-glow-three"></span>
    <span class="theme-toggle-scene theme-toggle-scene-day">
      <span class="theme-toggle-cloudbank theme-toggle-cloudbank-back"></span>
      <span class="theme-toggle-cloudbank theme-toggle-cloudbank-front"></span>
    </span>
    <span class="theme-toggle-scene theme-toggle-scene-night">
      <span class="theme-toggle-stars">
        <span class="theme-toggle-star theme-toggle-star-one"></span>
        <span class="theme-toggle-star theme-toggle-star-two"></span>
        <span class="theme-toggle-star theme-toggle-star-three"></span>
        <span class="theme-toggle-star theme-toggle-star-four"></span>
        <span class="theme-toggle-star theme-toggle-star-five"></span>
        <span class="theme-toggle-star theme-toggle-star-six"></span>
        <span class="theme-toggle-star theme-toggle-star-seven"></span>
        <span class="theme-toggle-star theme-toggle-star-eight"></span>
        <span class="theme-toggle-star theme-toggle-star-nine"></span>
      </span>
    </span>
    <span class="theme-toggle-thumb">
      <span class="theme-toggle-thumb-sun"></span>
      <span class="theme-toggle-thumb-moon">
        <span class="theme-toggle-crater theme-toggle-crater-one"></span>
        <span class="theme-toggle-crater theme-toggle-crater-two"></span>
        <span class="theme-toggle-crater theme-toggle-crater-three"></span>
      </span>
    </span>
  </span>
</button>
