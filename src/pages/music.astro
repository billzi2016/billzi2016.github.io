---
import { pageMeta } from "../data/pageMeta";
import MusicInitialContent from "../components/MusicInitialContent.astro";
import SiteLayout from "../layouts/SiteLayout.astro";

const meta = pageMeta.music;
---

<SiteLayout title={meta.title} description={meta.description} page="music" pageTag={meta.pageTag}>
  <MusicInitialContent lang="en" />
  <Fragment slot="page-templates">
    <template id="page-content-template-en">
      <MusicInitialContent lang="en" />
    </template>
    <template id="page-content-template-zh">
      <MusicInitialContent lang="zh" />
    </template>
  </Fragment>
</SiteLayout>
