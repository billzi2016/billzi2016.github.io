---
import { pageMeta } from "../data/pageMeta";
import ProjectsInitialContent from "../components/ProjectsInitialContent.astro";
import SiteLayout from "../layouts/SiteLayout.astro";

const meta = pageMeta.projects;
---

<SiteLayout title={meta.title} page="projects" pageTag={meta.pageTag}>
  <ProjectsInitialContent lang="en" />
  <Fragment slot="page-templates">
    <template id="page-content-template-en">
      <ProjectsInitialContent lang="en" />
    </template>
    <template id="page-content-template-zh">
      <ProjectsInitialContent lang="zh" />
    </template>
  </Fragment>
</SiteLayout>
