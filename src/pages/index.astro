---
import { pageMeta } from "../data/pageMeta";
import HomeInitialContent from "../components/HomeInitialContent.astro";
import SiteLayout from "../layouts/SiteLayout.astro";

const meta = pageMeta.home;
---

<SiteLayout title={meta.title} description={meta.description} page="home" lead>
  <Fragment slot="lead">
    I am an AI engineer, researcher, and Ph.D. in Computer Science working across <strong
      >Large Language Models (LLMs)</strong
    >,
    <strong>multimodal Artificial Intelligence (AI)</strong>, medical AI, sensing security, embedded
    hardware, sensing platforms, <strong>intelligent manufacturing systems</strong>, Machine
    Learning (ML) systems, and end-to-end AI deployment.
    <span class="lead-role-line">
      <strong>Target roles:</strong> Research Engineer, Applied Scientist, ML Engineer, LLM / AI Systems,
      hardware AI, sensing systems, and intelligent manufacturing systems roles.
    </span>
    My background also combines model development, system optimization, RAG and semantic retrieval pipelines,
    embedded integration, hardware-aware experimentation, manufacturing-system analysis, and bilingual
    communication for AI products, intelligent systems, manufacturing, and research.
  </Fragment>
  <HomeInitialContent lang="en" />
  <Fragment slot="page-templates">
    <template id="page-content-template-en">
      <HomeInitialContent lang="en" />
    </template>
    <template id="page-content-template-zh">
      <HomeInitialContent lang="zh" />
    </template>
  </Fragment>
</SiteLayout>
