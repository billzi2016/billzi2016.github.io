---
import { pageMeta } from "../data/pageMeta";
import PersonalInitialContent from "../components/PersonalInitialContent.astro";
import SiteLayout from "../layouts/SiteLayout.astro";

const meta = pageMeta.personal;
---

<SiteLayout title={meta.title} page="personal" pageTag={meta.pageTag}>
  <PersonalInitialContent lang="en" />
  <Fragment slot="page-templates">
    <template id="page-content-template-en">
      <PersonalInitialContent lang="en" />
    </template>
    <template id="page-content-template-zh">
      <PersonalInitialContent lang="zh" />
    </template>
  </Fragment>
</SiteLayout>
