---
import { pageMeta } from "../data/pageMeta";
import PublicationsInitialContent from "../components/PublicationsInitialContent.astro";
import SiteLayout from "../layouts/SiteLayout.astro";

const meta = pageMeta.publications;
---

<SiteLayout title={meta.title} page="publications" pageTag={meta.pageTag}>
  <PublicationsInitialContent lang="en" />
  <Fragment slot="page-templates">
    <template id="page-content-template-en">
      <PublicationsInitialContent lang="en" />
    </template>
    <template id="page-content-template-zh">
      <PublicationsInitialContent lang="zh" />
    </template>
  </Fragment>
</SiteLayout>
