---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { siteExperienceContent } from "../data/generated/experienceContent";
import { siteHomeContent } from "../data/generated/homeContent";
import { musicLibrary } from "../data/generated/musicLibrary";
import { siteProjectsContent } from "../data/generated/projectsContent";
import { publicationsData } from "../data/generated/publicationsData";
import { siteSharedContent } from "../data/generated/sharedContent";
import { sitePageTitles, siteTranslations } from "../data/generated/siteI18n";
import backgroundsScript from "../scripts/site/backgrounds.js?url";
import citationScript from "../scripts/site/site-citation.js?url";
import lightboxScript from "../scripts/site/site-lightbox.js?url";
import musicScript from "../scripts/site/site-music.js?url";
import routerScript from "../scripts/site/site-router.js?url";
import searchScript from "../scripts/site/site-search.js?url";
import siteScript from "../scripts/site/site.js?url";
import "../styles/tailwind.css";
import "../styles/site/main.css";
import "../components/MusicPlayer/music-player.css";
import "../components/SearchWidget/search-widget.css";

const { title, description, page, pageTag, lead = false } = Astro.props;

const siteContent = {
  shared: siteSharedContent,
  home: siteHomeContent,
  experience: siteExperienceContent,
  projects: siteProjectsContent,
};

const runtimeData = JSON.stringify({
  siteTranslations,
  sitePageTitles,
  siteContent,
  musicLibrary,
  publicationsData,
}).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/png" href="./assets/images/web-icon.png" />
    <script is:inline>
      document.documentElement.classList.add("theme-preload");
      try {
        if (localStorage.getItem("site-theme") === "dark") {
          document.documentElement.classList.add("dark-theme");
        }
      } catch (error) {
        document.documentElement.classList.remove("dark-theme");
      }
    </script>
  </head>
  <body data-page={page}>
    <div id="light-particles" class="background-layer background-particles"></div>
    <canvas id="dark-matrix" class="background-layer background-matrix" aria-hidden="true"></canvas>

    <div class="page-shell relative z-[1]">
      <div class="page mx-auto max-w-[1260px] px-[30px] pb-[84px] pt-[150px]">
        <header class="site-header relative pb-5">
          <div id="shared-header-slot" data-loaded="true">
            <Header />
          </div>
          {
            lead ? (
              <p class="lead" data-i18n="lead" data-i18n-rich="true">
                <slot name="lead" />
              </p>
            ) : (
              <div class="page-tag" data-i18n="pageTag">
                {pageTag}
              </div>
            )
          }
        </header>

        <main id="page-content">
          <slot />
        </main>
        <Footer />
        <slot name="page-templates" />
      </div>
    </div>

    <script
      is:inline
      set:html={`{
      const data = ${runtimeData};
      window.siteTranslations = data.siteTranslations;
      window.sitePageTitles = data.sitePageTitles;
      window.siteContent = data.siteContent;
      window.musicLibrary = data.musicLibrary;
      window.publicationsData = data.publicationsData;
    }`}
    />
    <script is:inline src="./vendor/particles/particles.min.js"></script>
    <script is:inline src={backgroundsScript}></script>
    <script is:inline src={musicScript}></script>
    <script is:inline src={citationScript}></script>
    <script is:inline src={searchScript}></script>
    <script is:inline src={lightboxScript}></script>
    <script is:inline src={routerScript}></script>
    <script is:inline src={siteScript}></script>
  </body>
</html>
