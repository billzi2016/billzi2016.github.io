---
import Header from "../components/Header.astro";
import "../styles/tailwind.css";

const {
  title,
  description,
  page,
  pageTag,
  lead = false,
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/png" href="./assets/images/web-icon.png" />
    <script is:inline>
      document.documentElement.classList.add("theme-preload");
      try {
        if (localStorage.getItem("site-theme") === "dark") {
          document.documentElement.classList.add("dark-theme");
        }
      } catch (error) {
        document.documentElement.classList.remove("dark-theme");
      }
    </script>
    <link rel="stylesheet" href="./styles/main.css?v=20260702-9" />
  </head>
  <body data-page={page}>
    <div id="light-particles" class="background-layer background-particles"></div>
    <canvas id="dark-matrix" class="background-layer background-matrix" aria-hidden="true"></canvas>

    <div class="page-shell relative z-[1]">
      <div class="page mx-auto max-w-[1260px] px-[30px] pb-[84px] pt-[150px]">
        <header class="site-header relative pb-5">
          <div id="shared-header-slot" data-loaded="true">
            <Header />
          </div>
          {lead ? (
            <p class="lead" data-i18n="lead" data-i18n-rich="true">
              <slot name="lead" />
            </p>
          ) : (
            <div class="page-tag" data-i18n="pageTag">{pageTag}</div>
          )}
        </header>

        <main id="page-content"></main>
      </div>
    </div>

    <script is:inline src="./scripts/data/shared-data.js"></script>
    <script is:inline src="./scripts/data/home-data.js"></script>
    <script is:inline src="./scripts/data/experience-data.js"></script>
    <script is:inline src="./scripts/data/projects-data.js"></script>
    <script is:inline src="./scripts/content-data.js"></script>
    <script is:inline src="./scripts/music-data.js"></script>
    <script is:inline src="./vendor/particles/particles.min.js"></script>
    <script is:inline src="./scripts/backgrounds.js"></script>
    <script is:inline src="./scripts/site-i18n.js?v=20260702-9"></script>
    <script is:inline src="./scripts/site-render-home.js?v=20260702-9"></script>
    <script is:inline src="./scripts/site-render-projects.js?v=20260702-9"></script>
    <script is:inline src="./scripts/site-music.js?v=20260702-9"></script>
    <script is:inline src="./scripts/site-publication-config.js?v=20260702-9"></script>
    <script is:inline src="./scripts/site-publication-utils.js?v=20260702-9"></script>
    <script is:inline src="./scripts/site-citation.js?v=20260702-9"></script>
    <script is:inline src="./scripts/site-publications.js?v=20260702-9"></script>
    <script is:inline src="./scripts/site-search.js?v=20260702-9"></script>
    <script is:inline src="./scripts/site-lightbox.js?v=20260702-9"></script>
    <script is:inline src="./scripts/site-router.js?v=20260702-9"></script>
    <script is:inline src="./scripts/site.js?v=20260702-9"></script>
  </body>
</html>
